#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * ClyoNutri II — Artisan Command Line Interface
 */

define('LARAVEL_START', microtime(true));

// Registrar Autoloader do Composer
if (file_exists($maintenance = __DIR__ . '/storage/framework/maintenance.php')) {
    require $maintenance;
}

require __DIR__ . '/vendor/autoload.php';

// Bootstrap da Aplicação
$app = require_once __DIR__ . '/bootstrap/app.php';

$command = $argv[1] ?? 'list';

echo "ClyoNutri II — Artisan CLI Environment (PHP " . PHP_VERSION . ")\n";

$replatformArtisan = __DIR__ . '/replatform/laravel13/artisan';

switch ($command) {
    case 'migrate':
        require __DIR__ . '/bin/migrate.php';
        exit(0);

    case 'healthcheck':
    case 'health':
        require __DIR__ . '/bin/healthcheck.php';
        exit(0);

    case 'quality-gate':
        require __DIR__ . '/bin/verify_quality_gate.php';
        exit(0);

    case 'version':
    case '--version':
    case '-V':
        if (file_exists($replatformArtisan)) {
            passthru(PHP_BINARY . ' ' . escapeshellarg($replatformArtisan) . ' --version');
        } else {
            echo "Laravel 13 Replatform Environment: Inactive (run setup in replatform/laravel13)\n";
        }
        exit(0);

    case 'list':
    default:
        if (file_exists($replatformArtisan) && !in_array($command, ['list', 'help'], true)) {
            // Repassar qualquer comando padrão do Laravel para o artisan real
            $cmdArgs = array_slice($argv, 1);
            passthru(PHP_BINARY . ' ' . escapeshellarg($replatformArtisan) . ' ' . implode(' ', array_map('escapeshellarg', $cmdArgs)), $exitCode);
            exit($exitCode);
        }

        echo "Comandos disponíveis (ClyoNutri CLI Wrapper):\n";
        echo "  migrate        Executa migrações estruturais do banco relacional de produção\n";
        echo "  healthcheck    Verifica integridade do sistema e conexão com banco\n";
        echo "  quality-gate   Executa a matriz independente de portões de qualidade\n";
        echo "  version        Exibe versão real do framework Laravel 13 (via replatform/laravel13)\n";
        if (file_exists($replatformArtisan)) {
            echo "\nAmbiente Laravel 13 ativo em: replatform/laravel13/\n";
            echo "Comandos padrão do Laravel (route:list, make:*, test) são delegados automaticamente ao framework real.\n";
        }
        exit(0);
}
