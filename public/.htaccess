<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redireciona cabeçalho Authorization para que o Sanctum e JWT funcionem no Apache/HostGator
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redireciona para HTTPS se habilitado pelo SSL
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Não reescreve arquivos ou diretórios físicos existentes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Bloqueio estrito de acesso a arquivos de configuração sensíveis e dotfiles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
