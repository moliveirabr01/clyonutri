# ClyoNutri - public/.htaccess (compatível com HostGator / Apache 2.4)
# Sem "Options", "php_value" ou "php_flag": em hospedagem compartilhada essas
# diretivas costumam ser proibidas no .htaccess e causam 500 Internal Server Error.

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Repassa o cabeçalho Authorization (tokens da API) no Apache/HostGator
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Força HTTPS (descomente quando o SSL do subdomínio estiver ativo)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Arquivos e pastas reais (assets) são servidos direto; o resto vai para index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Bloqueia dotfiles (.env, .htaccess, .git etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
