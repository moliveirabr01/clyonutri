# ClyoNutri - .htaccess da RAIZ do projeto.
# Só é usado quando a raiz do domínio aponta para a pasta do projeto (e não para public/).
# Tudo é encaminhado para public/; código, vendor, storage e .env nunca ficam acessíveis.
# Sem "Options"/"php_value"/"php_flag" (proibidos na HostGator -> 500).

DirectoryIndex index.php index.html

# Fallback para respostas nativas antes do encaminhamento a public/ (301/403).
# O mesmo fallback em public/ atende instalações com DocumentRoot diretamente lá.
# resp() consulta as duas tabelas: PHP continua dono dos cabeçalhos que já emitiu.
<IfModule mod_headers.c>
    Header always setifempty X-Content-Type-Options "nosniff" "expr=-z resp('X-Content-Type-Options')"
    Header always setifempty Referrer-Policy "strict-origin-when-cross-origin" "expr=-z resp('Referrer-Policy')"
    # NI2-811: Se o rollback estiver ativo (storage/hsts_rollback), força max-age=0 em absolutamente TODAS as respostas (inclusive assets estáticos, redirecionamentos e erros 403/404)
    Header always set Strict-Transport-Security "max-age=0" "expr=-f '%{DOCUMENT_ROOT}/../storage/hsts_rollback' || -f '%{DOCUMENT_ROOT}/storage/hsts_rollback' || -n reqenv('HSTS_ROLLBACK')"
    # Se o rollback NÃO estiver ativo, aplica o baseline de 15552000 (6 meses, NI2-885) apenas quando o PHP não tiver emitido e o rollback não estiver ativo
    Header always setifempty Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on' && -z resp('Strict-Transport-Security') && ! -f '%{DOCUMENT_ROOT}/../storage/hsts_rollback' && ! -f '%{DOCUMENT_ROOT}/storage/hsts_rollback' && -z reqenv('HSTS_ROLLBACK')"
    # NI2-809 / ZAP-10038: Garante baseline CSP em todas as respostas nativas do Apache (erros 406, 403, 404, 500)
    Header always setifempty Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" "expr=-z resp('Content-Security-Policy')"
    # NI2-812 / ZAP-10063: Garante baseline Permissions-Policy em respostas nativas do Apache
    Header always setifempty Permissions-Policy "camera=(), microphone=(), display-capture=(), geolocation=(), payment=()" "expr=-z resp('Permissions-Policy')"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # NI2-427 / v10: HTTPS obrigatório (primeira barreira; o PHP repete a checagem).
    # Está nos DOIS .htaccess (raiz e public/): vale qualquer que seja a pasta raiz do domínio.
    # "Já é HTTPS" = %{HTTPS}=on OU %{ENV:HTTPS}=on OU X-Forwarded-Proto=https (sem loop atrás de
    # proxy). Um X-Forwarded-Proto forjado só faz a requisição chegar ao PHP, que (com
    # TRUSTED_PROXIES vazio) redireciona/recusa do mesmo jeito.
    # O Location nunca usa um Host arbitrário: só hosts conhecidos; outros seguem para o PHP,
    # que redireciona para o APP_URL do .env. (A condição do Host vem por último: %1.)
    # 1) www -> https://clyonutri.com (um único salto, de http ou https)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP_HOST} ^www\.(clyonutri\.com(\.br)?)(:(80|443))?$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    # 2) http -> https no mesmo host conhecido (GET/HEAD 301; outros métodos 403)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{ENV:HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP_HOST} ^((www\.|staging\.)?clyonutri\.com(\.br)?)(:80)?$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{ENV:HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteCond %{HTTP_HOST} ^((www\.|staging\.)?clyonutri\.com(\.br)?)(:80)?$ [NC]
    RewriteRule ^ - [F,L]

    # NI2-808 / ZAP-40025: Bloqueio de métodos de diagnóstico e proxy (TRACE, TRACK, CONNECT)
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|CONNECT) [NC]
    RewriteRule .* - [F,L]

    # NI2-811: Detecção unificada de Rollback de HSTS (de ponta a ponta)
    RewriteCond %{DOCUMENT_ROOT}/../storage/hsts_rollback -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/storage/hsts_rollback -f
    RewriteRule ^ - [E=HSTS_ROLLBACK:1]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Encaminha tudo para public/ (sem loop: o que já está em public/ não é reescrito de novo)
    # v20: link antigo do app do paciente (/app?code=...) -> /paciente/app (a query é preservada)
    RewriteRule ^app/?$ /paciente/app [R=301,L]
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Reserva caso mod_rewrite falhe: bloqueia pastas e arquivos sensíveis
<IfModule mod_alias.c>
    RedirectMatch 404 ^/app/.
    RedirectMatch 404 ^/(src|vendor|storage|config|database|bin|views|routes|bootstrap|tests|docs|mobile|release|replatform)(/|$)
    RedirectMatch 404 /\.(env|git|htaccess)
    RedirectMatch 404 ^/(composer\.(json|lock)|artisan)$
</IfModule>

# v10 (2.2): dumps, backups, bancos, logs e configs nunca são servidos, mesmo se forem parar em public/.
<FilesMatch "(?i)(\.(sql|sqlite3?|db|zip|tar|gz|tgz|rar|7z|bak|old|orig|save|swp|tmp|log|ini|conf|env|sh|lock|dist|phar|md)$|^error_log$|^composer\.(json|lock)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
