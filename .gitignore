.DS_Store
.env
storage/logs/*.log
storage/uploads/*
storage/*.sqlite
database/*.sqlite
database/*.db
*.db
storage/backups/*
storage/*.json
storage/simulated_deploy/
storage/rehearsal_restore/
release/*.tar.gz
vendor/
replatform/laravel13/vendor/
replatform/laravel13/.env
replatform/laravel13/database/*.sqlite
replatform/laravel13/storage/*.sqlite
!storage/logs/.gitkeep
!storage/uploads/.gitkeep
!storage/backups/.gitkeep
storage/app/helpdesk_attachments/*
!storage/app/helpdesk_attachments/.gitkeep

# Arquivos auxiliares do SQLite (WAL/SHM) e banco isolado de testes
storage/*.sqlite-*
storage/testing.sqlite

# Artefatos locais de release/deploy (pacotes, extrações, patches e logs de build)
release/*.zip
release/*.patch
release/clyonutri_*/
release/.claude_*
bin/release.log

# Bancos de dados locais em qualquer pasta (nunca versionar dados)
*.sqlite
*.sqlite-*
*.sqlite3

# Gate de homologação (NI2-409): evidências por execução e dependências dos testes
release/evidence/
storage/homologation-local/
tests/homologation/node_modules/
mobile/node_modules/
mobile/dist/

# Testes de navegador da teleconsulta (dependências npm locais) e sessões de teste
tests/teleconsulta_navegador/node_modules/
storage/sessions/
tests/prontuario_impressao/node_modules
tests/plano_impressao/node_modules
