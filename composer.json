{
  "name": "clyonutri/app",
  "description": "ClyoNutri - Sistema Operacional do Nutricionista",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "phpmailer/phpmailer": "^6.9"
  },
  "autoload": {
    "psr-4": {
      "ClyoNutri\\": "src/",
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ClyoNutri\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrate.php",
    "seed": "php bin/seed.php"
  }
}
