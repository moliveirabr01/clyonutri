    "/auth/patient-login": {
      "post": {
        "summary": "Login da paciente (app/portal)",
        "operationId": "patientLogin",
        "tags": [
          "Autenticação"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientSession"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Conta inexistente e senha errada recebem a mesma resposta 401. Limite de tentativas por conta e IP (429 com Retry-After). Com o cabeçalho X-ClyoNutri-Web: 1 e origem permitida, também grava o cookie HttpOnly clyonutri_mobile.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientLoginRequest"
              }
            }
          }
        }
      }
    },
