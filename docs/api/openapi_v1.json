        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "is_favorite": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Receita"
          }
        ]
      }
    },
    "/patient/recipes-shopping-list": {
      "get": {
        "summary": "Lista de compras das receitas prescritas",
        "operationId": "patientRecipesShoppingList",
        "tags": [
          "Receitas"
        ],
        "security": [
          {
            "bearerToken": []
          },
          {
            "webSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 7
            }
          }
        ]
      }
    },
    "/patient/privacy": {
      "get": {
        "summary": "Consentimentos e pedidos LGPD da própria paciente",
        "operationId": "patientPrivacy",
        "tags": [
          "Privacidade"
        ],
        "security": [
          {
            "bearerToken": []
          },
          {
            "webSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "consents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "purpose": {
                            "type": "string"
                          },
                          "term_title": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "term_version": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "granted": {
                            "type": "boolean"
                          },
                          "granted_at": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "revoked_at": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "revocation_reason": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "requests": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PrivacyRequest"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/patient/privacy-requests": {
      "post": {
        "summary": "Abre pedido LGPD (cópia ou exclusão dos dados)",
        "operationId": "patientCreatePrivacyRequest",
        "tags": [
          "Privacidade"
        ],
        "security": [
          {
            "bearerToken": []
          },
          {
            "webSessionCookie": []
          }
        ],
        "description": "O pedido entra na fila da clínica (/privacidade/pedidos) com prazo de 15 dias. Pedido igual em aberto não é duplicado (200 com already_open). A exclusão anonimiza o cadastro; o prontuário fica sob guarda legal.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request_type"
                ],
                "properties": {
                  "request_type": {
                    "type": "string",
                    "enum": [
                      "export",
                      "deletion"
                    ]
                  },
                  "details": {
                    "type": "string",
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "$ref": "#/components/schemas/PrivacyRequest"
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "Já havia pedido igual em aberto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request": {
                      "$ref": "#/components/schemas/PrivacyRequest"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token opaco de 64 caracteres hexadecimais emitido no login"
      },
      "webSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "clyonutri_mobile"
      }
    },
    "responses": {
      "Error": {
        "description": "Erro",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "nutritionist",
              "assistant",
              "patient",
              "admin"
            ]
          }
        }
      },
      "Clinic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Patient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "anonymized"
            ]
          }
        }
      },
      "ClinicalRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "version": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "record_hash": {
            "type": "string"
          },
          "previous_hash": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MealPlanVersion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "version_number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "daily_energy_kcal": {
            "type": "number"
          },
          "payload": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "superseded"
            ]
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Profile360": {
        "type": "object",
        "properties": {
          "patient": {
            "$ref": "#/components/schemas/Patient"
          },
          "active_plan": {
            "$ref": "#/components/schemas/MealPlanVersion"
          },
          "assessments_count": {
            "type": "integer"
          },
          "timeline": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Mensagem para o usuário, sem detalhe interno"
          },
          "code": {
            "type": "string",
            "description": "Código estável (ex.: VALIDATION_ERROR, FORBIDDEN, HTTP_401, INTERNAL_ERROR)"
          },
          "request_id": {
            "type": "string",
            "description": "Identificador da requisição para suporte (também no cabeçalho X-Request-ID)"
          }
        },
        "required": [
          "error",
          "code",
          "request_id"
        ]
      },
      "PatientLoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "description": "Alternativa ao e-mail"
          },
          "password": {
            "type": "string",
            "description": "Senha ou PIN de acesso"
          },
          "otp": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "Código de uso único, alternativo à senha"
          }
        },
        "description": "Informe e-mail ou telefone, e senha/PIN ou OTP. Só o identificador é recusado (401)."
      },
      "PatientSession": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Token opaco; o servidor guarda só o hash SHA-256"
          },
          "expires_at": {
            "type": "string",
            "description": "UTC, formato Y-m-d H:i:s (30 dias)"
          },
          "patient": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "clinic_id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "token",
          "expires_at",
          "patient"
        ]
      },
      "PatientHome": {
        "type": "object",
        "properties": {
          "patient_name": {
            "type": "string"
          },
          "water_ml_today": {
            "type": "integer"
          },
          "water_goal_ml": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Meta prescrita; null quando não há"
          },
          "next_appointment": {
            "type": [
              "object",
              "null"
            ]
          },
          "active_plan": {
            "type": [
              "object",
              "null"
            ],
            "description": "Plano publicado vigente da própria paciente"
          }
        },
        "required": [
          "patient_name",
          "water_ml_today",
          "water_goal_ml",
          "next_appointment",
          "active_plan"
        ]
      },
      "FoodDiaryEntryInput": {
        "type": "object",
        "properties": {
          "meal_name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "consumed_at": {
            "type": "string",
            "description": "Data/hora; não pode estar mais de 1 dia no futuro. Padrão: agora"
          },
          "hunger_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "satiety_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "symptoms": {
            "type": "string",
            "maxLength": 1000
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 64,
            "description": "Repetir a mesma chave devolve o registro já criado"
          }
        },
        "required": [
          "meal_name"
        ],
        "description": "photo_path enviado pelo cliente é ignorado nesta rota."
      },
      "FoodDiaryEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "meal_name": {
            "type": "string"
          },
          "patient_id": {
            "type": "integer"
          },
          "consumed_at": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "idempotent_replay": {
            "type": "boolean"
          }
        }
      },
      "ChatMessages": {
        "type": "object",
        "properties": {
          "conversation_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "professional": {
            "type": [
              "object",
              "null"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": "object",
            "properties": {
              "after_id": {
                "type": "integer"
              },
              "count": {
                "type": "integer"
              },
              "has_more": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Evolution": {
        "type": "object",
        "properties": {
          "patient_id": {
            "type": "integer"
          },
          "clinical_records": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "self_reports": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "clinical_count": {
                "type": "integer"
              },
              "self_report_count": {
                "type": "integer"
              },
              "total_entries": {
                "type": "integer"
              },
              "has_data": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "PrivacyRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "request_type": {
            "type": "string",
            "enum": [
              "export",
              "deletion",
              "access",
              "anonymization",
              "rectification"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_review",
              "completed",
              "completed_legal_hold",
              "rejected_legal_hold"
            ]
          },
          "deadline_at": {
            "type": "string",
            "description": "Prazo de resposta (15 dias), fuso da aplicação"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "response_notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "already_open": {
            "type": "boolean",
            "description": "Só na criação: true quando já havia pedido igual em aberto"
          }
        }
      }
    }
  }
}
