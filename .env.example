# Configurações do Ambiente ClyoNutri
APP_NAME=Clyo Nutri
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo

# Banco de Dados (Suporta MySQL ou SQLite local para desenvolvimento/testes rápidos)
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
# Configurações para MySQL 8+:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=clyonutri
# DB_USERNAME=clyonutri_user
# DB_PASSWORD=clyonutri_pass
# DB_CHARSET=utf8mb4

# Sessão e Segurança
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Mail (Configurável para SMTP/SES)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@clyonutri.com
MAIL_FROM_NAME="Clyo Nutri"

# NI2-362 / NI2-446: contatos públicos (rodapés, /termos, /privacidade, login).
# Vazios, o sistema usa suporte@ e dpo@ do domínio do APP_URL. Em produção, preencha com caixas que existem:
# APP_SUPPORT_EMAIL=suporte@clyonutri.com e APP_DPO_EMAIL=dpo@clyonutri.com
APP_SUPPORT_EMAIL=
APP_DPO_EMAIL=
# Exact additional web origins, comma-separated. Same-host web ports are accepted.
MOBILE_WEB_ORIGINS=

# Consultório Online / Teleconsulta (NI2-221)
# webrtc_p2p (padrão, gratuito): vídeo direto entre navegadores, sinalização no próprio backend.
# daily_co: Daily (pago), exige DAILY_API_KEY e DAILY_DOMAIN.
TELECONSULT_PROVIDER=webrtc_p2p
# Credenciais de mídia são assinadas com APP_KEY (mínimo 16 caracteres).
# STUN público gratuito (padrão se vazio). Separe por vírgula.
TELECONSULT_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN opcional: melhora a conexão em redes restritivas (4G com CGNAT, firewalls).
# Sem TURN, parte das chamadas nessas redes não conecta. Ex.: coturn próprio.
TELECONSULT_TURN_URLS=
TELECONSULT_TURN_USERNAME=
TELECONSULT_TURN_CREDENTIAL=
# Janela de entrada (minutos antes do horário / tolerância após o fim) e validade da credencial.
TELECONSULT_JOIN_EARLY_MINUTES=15
TELECONSULT_JOIN_GRACE_MINUTES=30
TELECONSULT_CREDENTIAL_TTL_MINUTES=90
# DAILY_API_KEY=
# DAILY_DOMAIN=

# NI2-95 — avisos no celular (Expo Push Service) e lembrete de consulta.
# Copie as linhas que precisar para o .env do servidor. Não coloque segredo neste arquivo.

# Push no celular da paciente. Fica desligado até você confirmar o projectId do EAS no app
# e gerar um build novo com expo-notifications. Para ligar: PUSH_ENABLED=true
PUSH_ENABLED=false

# Só preencha se o projeto no Expo estiver com "Enhanced security for push notifications" ligado.
# O token é criado em expo.dev > Account settings > Access tokens. Deixe vazio caso contrário.
EXPO_ACCESS_TOKEN=

# Antecedência padrão do lembrete de consulta, em horas (1 a 72). A clínica e cada profissional
# podem trocar em Configurações > Lembrete de consulta; este valor vale para quem não ajustou.
NOTIFICATION_APPOINTMENT_REMINDER_HOURS=24

# ---- Acrescentado na v29 (variáveis que o código e os LEIA-ME da v28 passaram a usar) ----
# Só placeholders, sem valores. Copie a linha que precisar para o .env do servidor e preencha lá.
# Não coloque segredo neste arquivo.

# Envio de e-mail por SMTP (NI2-481). Com MAIL_DRIVER=log ou null nenhum e-mail sai. Para enviar:
# MAIL_DRIVER=smtp
# MAIL_HOST=
# MAIL_PORT=
# MAIL_ENCRYPTION=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Segundos de espera por resposta do servidor SMTP (padrão 15). NI2-877: vale por resposta, não só na conexão.
# MAIL_TIMEOUT=15
# Conferir as integrações (Asaas, SMTP, teleconsulta, voz): php bin/integration_check.php [--smtp-send=voce@dominio] [--asaas-ping] [--evidence=ID_DA_CLINICA]

# HSTS (segundos). Em produção o padrão é 15552000 (6 meses, NI2-885); 0 não envia o cabeçalho.
# Deixe vazio para usar o padrão. Um valor antigo (ex.: 86400) aqui continua valendo e segura o HSTS em 1 dia.
# HSTS_MAX_AGE=

# Reaceite obrigatório dos Termos (NI2-449). Desligado se ausente. Ver o aviso no LEIA-ME antes de ligar.
# LEGAL_REACCEPTANCE_ENABLED=

# NI2-596: links antigos /agendar/{número} redirecionam para o apelido único. Desligar (false) a partir de 01/12/2026.
BOOKING_LEGACY_NUMERIC_LINKS=true

# Cifragem clínica em repouso (obrigatória em produção - AES-256-GCM)
CLINICAL_ENCRYPTION_KEY=

# Assinatura e gateway Asaas
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
TRIAL_EXPIRED_GRACE_DAYS=3

# Development-only query counters; disabled in production even when set to 1.
DB_QUERY_PROFILE=0

# MFA da plataforma suspenso conforme decisão vigente; true volta a exigir.
MFA_PLATFORM_REQUIRED=false
