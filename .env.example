# Configurações do Ambiente ClyoNutri
APP_NAME=ClyoNutri
APP_ENV=local
APP_KEY=base64_clyonutri_secret_key_production_ready_99218274192
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo

# Banco de Dados (Suporta MySQL ou SQLite local para desenvolvimento/testes rápidos)
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
# Configurações para MySQL 8+:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=clyonutri
# DB_USERNAME=clyonutri_user
# DB_PASSWORD=clyonutri_pass
# DB_CHARSET=utf8mb4

# Sessão e Segurança
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Mail (Configurável para SMTP/SES)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@clyonutri.com.br
MAIL_FROM_NAME="ClyoNutri"
