# ==============================================================================
# ClyoNutri II — Configuração de Produção para HostGator (cPanel / MySQL 8.0)
# ==============================================================================
# INSTRUÇÕES DE SEGURANÇA:
# 1. Copie este arquivo para: /home/USUARIO/clyonutri/shared/.env
# 2. Defina as permissões restritas: chmod 600 /home/USUARIO/clyonutri/shared/.env
# 3. NUNCA armazene este arquivo dentro de public_html!
# ==============================================================================

# Aplicação
APP_NAME="ClyoNutri"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:clyonutri_hostgator_prod_secret_key_20261013_secure
APP_URL=https://app.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo

# Banco de Dados MySQL 8.0 (HostGator AlmaLinux)
# No cPanel, nomes de banco e usuário possuem o prefixo da sua conta (ex: seunome_clyonutri)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=seunome_clyonutri
DB_USERNAME=seunome_clyouser
DB_PASSWORD=DefinaSuaSenhaForteAqui!123
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sessão e Segurança de Cookies (HTTPS Obrigatório)
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# E-mail Transacional (HostGator Webmail ou Provedor SMTP Externo / SendGrid / SES)
# E-mails críticos (reset de senha, verificação, convites) são disparados sincronamente
MAIL_DRIVER=smtp
MAIL_HOST=mail.seudominio.com.br
MAIL_PORT=465
MAIL_USERNAME=noreply@seudominio.com.br
MAIL_PASSWORD=SenhaDoEmailAqui
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@seudominio.com.br
MAIL_FROM_NAME="ClyoNutri"

# Suporte ao Cliente (Obrigatório em produção - NI2-362)
APP_SUPPORT_EMAIL=suporte@seudominio.com.br

# Origens CORS autorizadas para acesso Web e Mobile (separadas por vírgula)
MOBILE_WEB_ORIGINS=https://app.seudominio.com.br
